---
import { t } from '@i18n/index';
import { SITE, buildWhatsAppLink } from '@data/site';
const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-ink/10">
  <div class="container-edit py-16 grid gap-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-start gap-4">
        <img src="/logo.jpeg" alt="Abril" class="h-14 w-14 object-cover rounded-full ring-1 ring-ink/15 flex-shrink-0" width="56" height="56" />
        <div>
          <p class="font-serif text-2xl text-ink">Abril Pijamas y Lencería</p>
          <p class="mt-3 text-sm text-ink/70 max-w-xs">{t('footer.tagline')}</p>
        </div>
      </div>
      <a href={buildWhatsAppLink()} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 px-5 py-2.5 bg-burgundy text-crema text-xs tracking-wider uppercase hover:bg-burgundy-900 transition">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.492 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zM6.597 20.13c1.676.995 3.276 1.59 5.452 1.59 5.448 0 9.886-4.434 9.889-9.885a9.86 9.86 0 00-2.893-7.005A9.79 9.79 0 0012.055 2.5c-5.45 0-9.887 4.434-9.89 9.884a9.85 9.85 0 001.599 5.392l-.999 3.648 3.832-.494z"/></svg>
        {t('contacto.whatsapp')}
      </a>
    </div>
    <div class="text-sm space-y-2">
      <p class="eyebrow mb-3">{t('nav.contacto')}</p>
      <a href={SITE.instagram} target="_blank" rel="noopener" class="block text-burgundy hover:underline">Instagram</a>
      <a href={SITE.facebook} target="_blank" rel="noopener" class="block text-burgundy hover:underline">Facebook</a>
      <a href={SITE.tiktok} target="_blank" rel="noopener" class="block text-burgundy hover:underline">TikTok</a>
      <a href={buildWhatsAppLink()} target="_blank" rel="noopener" class="block text-burgundy hover:underline">WhatsApp</a>
    </div>
    <div class="text-sm space-y-2">
      <p class="eyebrow mb-3">Catálogo</p>
      <a href="/catalogo#cat=pijamas" class="block text-ink hover:text-burgundy transition-colors">Pijamas</a>
      <a href="/catalogo#cat=lenceria" class="block text-ink hover:text-burgundy transition-colors">Lencería</a>
      <a href="/catalogo#cat=conjuntos" class="block text-ink hover:text-burgundy transition-colors">Conjuntos</a>
      <a href="/catalogo" class="block text-ink hover:text-burgundy transition-colors">Ver todo</a>
    </div>
  </div>
  <div class="container-edit pb-10 text-xs text-ink/50 flex justify-between">
    <span>© {year} Abril Pijamas y Lencería. {t('footer.rights')}</span>
    <span>Hecho con cuidado en Colombia</span>
  </div>
</footer>
