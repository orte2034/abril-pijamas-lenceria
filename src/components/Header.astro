---
import { t } from '@i18n/index';

---

<header class="sticky top-0 z-40 bg-crema/85 backdrop-blur-sm border-b border-ink/10">
  <div class="container-edit flex items-center justify-between h-16 md:h-20">
    <a href="/" class="flex items-center gap-3 group">
      <img src="/logo.jpeg" alt="Abril Pijamas y Lencería" class="h-9 w-9 md:h-11 md:w-11 object-cover rounded-full ring-1 ring-ink/10 transition group-hover:ring-burgundy/40" width="44" height="44" />
      <span class="font-serif text-lg md:text-xl tracking-tight text-ink leading-none">
        Abril&nbsp;<span class="text-burgundy">Pijamas y Lencería</span>
      </span>
    </a>
    <nav class="flex items-center gap-6 md:gap-10 text-xs md:text-sm tracking-wider uppercase">
      <a href="/catalogo" class="hover:text-burgundy transition-colors">{t('nav.catalogo')}</a>
      <a href="/catalogo#cat=pijamas" class="hover:text-burgundy transition-colors hidden md:inline">Pijamas</a>
      <a href="/catalogo#cat=lenceria" class="hover:text-burgundy transition-colors hidden md:inline">Lencería</a>
      <a href="/catalogo#cat=conjuntos" class="hover:text-burgundy transition-colors hidden md:inline">Conjuntos</a>
      <a href="/contacto" class="hover:text-burgundy transition-colors">{t('nav.contacto')}</a>
    </nav>
  </div>
</header>
