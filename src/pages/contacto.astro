---
import Base from '@layouts/Base.astro';
import { t } from '@i18n/index';
import { SITE, buildWhatsAppLink } from '@data/site';
const wa = buildWhatsAppLink();
---

<Base title={`Contacto · Abril Pijamas y Lencería`}>
  <section class="container-edit pt-24 pb-16">
    <p class="eyebrow reveal">{t('contacto.title')}</p>
    <h1 class="reveal mt-6 font-serif text-display text-ink max-w-content">{t('contacto.title')}</h1>
    <p class="reveal mt-6 text-lead text-ink/75 max-w-editorial">{t('contacto.subtitle')}</p>
  </section>

  <section class="container-edit pb-32 grid md:grid-cols-2 gap-16">
    <div class="space-y-4">
      <a href={wa} target="_blank" rel="noopener" class="block border border-ink/15 p-6 hover:border-burgundy transition group">
        <p class="eyebrow mb-2">WhatsApp</p>
        <p class="text-2xl font-serif text-burgundy group-hover:underline">{t('contacto.whatsapp')}</p>
        <p class="mt-2 text-xs text-ink/50">+57 316 906 4533</p>
      </a>
      <a href={SITE.instagram} target="_blank" rel="noopener" class="block border border-ink/15 p-6 hover:border-burgundy transition group">
        <p class="eyebrow mb-2">Instagram</p>
        <p class="text-2xl font-serif text-burgundy group-hover:underline">@abrilpijamasylenceria</p>
      </a>
      <a href={SITE.facebook} target="_blank" rel="noopener" class="block border border-ink/15 p-6 hover:border-burgundy transition group">
        <p class="eyebrow mb-2">Facebook</p>
        <p class="text-2xl font-serif text-burgundy group-hover:underline">Abril Pijamas y Lencería</p>
      </a>
      <a href={SITE.tiktok} target="_blank" rel="noopener" class="block border border-ink/15 p-6 hover:border-burgundy transition group">
        <p class="eyebrow mb-2">TikTok</p>
        <p class="text-2xl font-serif text-burgundy group-hover:underline">@abrilpijamasylenceria</p>
      </a>
    </div>

    <form class="space-y-5" action={`https://formspree.io/f/${import.meta.env.FORMSPREE_ID || 'your-form-id'}`} method="post" data-contact-form>
      <div>
        <label class="eyebrow block mb-2" for="name">{t('contacto.form.name')}</label>
        <input id="name" name="name" required class="w-full border-b border-ink/30 bg-transparent py-3 focus:border-burgundy outline-none" />
      </div>
      <div>
        <label class="eyebrow block mb-2" for="email">{t('contacto.form.email')}</label>
        <input id="email" name="email" type="email" required class="w-full border-b border-ink/30 bg-transparent py-3 focus:border-burgundy outline-none" />
      </div>
      <div>
        <label class="eyebrow block mb-2" for="message">{t('contacto.form.message')}</label>
        <textarea id="message" name="message" rows="5" required class="w-full border-b border-ink/30 bg-transparent py-3 focus:border-burgundy outline-none resize-none"></textarea>
      </div>
      <button type="submit" class="px-8 py-3.5 bg-burgundy text-crema text-sm tracking-wider uppercase hover:bg-burgundy-900 transition">
        {t('contacto.form.submit')}
      </button>
    </form>
  </section>
</Base>
