---
import Base from '@layouts/Base.astro';
---

<Base title="Página no encontrada · Abril">
  <section class="container-edit pt-32 pb-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-6 font-serif text-6xl text-ink">Página no encontrada</h1>
    <p class="mt-4 text-ink/70">La pieza que buscas puede no estar disponible.</p>
    <a href="/" class="inline-block mt-8 px-8 py-3.5 bg-burgundy text-crema text-sm uppercase tracking-wider hover:bg-burgundy-900 transition">Volver al inicio</a>
  </section>
</Base>
